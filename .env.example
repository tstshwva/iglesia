# El servidor usa variables del sistema; este archivo es una referencia, no se carga automáticamente.
HOST=127.0.0.1
PORT=3000
# DB_PATH=ruta/privada/church.sqlite
# Para alojamiento con HTTPS:
# COOKIE_SECURE=true
# Configurar un token de instalación solo si se usa la API para configurar el primer administrador:
# SETUP_TOKEN=valor-aleatorio-privado
# En producción, servicio que envía el token por correo:
# RESET_WEBHOOK=https://tu-servicio-privado.example/enviar-recuperacion
# RESET_WEBHOOK_SECRET=secreto-privado-del-servicio
