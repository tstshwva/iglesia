# Copia este archivo a .env para personalizar. Nunca subas .env a GitHub.
HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000
COOKIE_SECURE=false
NODE_ENV=development
# DB_PATH=/ruta/privada/church.sqlite
# En producción: APP_URL=https://tu-dominio, COOKIE_SECURE=true, NODE_ENV=production.
# Proteger el alta del primer administrador; el formulario solicita este valor:
# SETUP_TOKEN=valor-largo-aleatorio-y-privado
# Recuperación por correo SMTP (no poner contraseñas en el repositorio):
# SMTP_HOST=smtp.tu-proveedor.example
# SMTP_PORT=587
# SMTP_USER=cuenta-del-correo
# SMTP_PASSWORD=contraseña-de-aplicación
# MAIL_FROM="Siloé <correo@tu-dominio.example>"
# SMTP_REQUIRE_TLS=true
# Alternativa: webhook HTTPS que envía el correo:
# RESET_WEBHOOK=https://tu-servicio-privado.example/enviar-recuperacion
# RESET_WEBHOOK_SECRET=secreto-del-servicio
